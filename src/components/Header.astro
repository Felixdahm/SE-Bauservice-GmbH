---
const navLinks = [
  { label: 'Startseite',  href: '/' },
  { label: 'Leistungen',  href: '/leistungen' },
  { label: 'Über uns',    href: '/ueber-uns' },
  { label: 'Kontakt',     href: '/kontakt' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <!-- Hauptnavigation -->
  <div class="header-inner">
    <a href="/" class="logo" aria-label="SE Bauservice GmbH – Startseite">
      <span class="logo-text">SE BAUSERVICE GMBH</span>
    </a>

    <button class="nav-toggle" aria-label="Menü öffnen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul class="nav-list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/kontakt" class="btn btn-primary header-cta">Jetzt anfragen</a>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const nav = document.querySelector('.nav') as HTMLElement;
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav.classList.toggle('nav--open');
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-primary);
  }

  /* Hauptzeile */
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 90px;
    padding-left: 5%;
    padding-right: 5%;
  }

  .logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-self: start;
  }

  .logo-text {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #fff;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-self: center;
  }

  .nav-list {
    display: flex;
    gap: 32px;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255,255,255,0.72);
    transition: color 0.18s;
  }
  .nav-link:hover,
  .nav-link.active {
    color: #fff;
  }

  .header-cta {
    padding: 10px 22px;
    font-size: 0.875rem;
    white-space: nowrap;
    justify-self: end;
  }

  /* Hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    justify-self: end;
    grid-column: 3;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  @media (max-width: 768px) {
    .nav-toggle { display: flex; }
    .header-cta { display: none; }

    .nav {
      display: none;
      position: absolute;
      top: 90px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--color-primary);
      padding: 16px 24px 24px;
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    .nav.nav--open { display: flex; }

    .nav-list {
      flex-direction: column;
      gap: 0;
      width: 100%;
    }
    .nav-link {
      display: block;
      padding: 13px 0;
      font-size: 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
  }
</style>
